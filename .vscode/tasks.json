{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ensure-docker",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\ensure-docker.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-postgres",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-ocr",
      "type": "shell",
      "command": "docker compose up -d ocr-service",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-dev-services",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ensure-docker",
        "start-postgres",
        "start-ocr"
      ],
      "problemMatcher": []
    },
    {
      "label": "start-frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "frontend",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*http://localhost:5173"
        }
      },
      "dependsOn": "start-dev-services"
    },
    {
      "label": "run-tests",
      "type": "shell",
      "command": "mvn test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run-backend-coverage",
      "type": "shell",
      "command": "mvn verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run-frontend-tests",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "run-frontend-coverage",
      "type": "shell",
      "command": "npm run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "run-ocr-tests",
      "type": "shell",
      "command": "python -m pytest -q",
      "options": {
        "cwd": "${workspaceFolder}\\ocr-service"
      },
      "problemMatcher": []
    },
    {
      "label": "run-ocr-coverage",
      "type": "shell",
      "command": "python -m pytest --cov=app --cov-report=term-missing --cov-report=html",
      "options": {
        "cwd": "${workspaceFolder}\\ocr-service"
      },
      "problemMatcher": []
    },
    {
      "label": "run-all-coverage-and-open-reports",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\run-all-coverage.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "open-coverage-reports",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\open-coverage-reports.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run-all-tests-and-open-report",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\run-all-tests-report.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "run-all-tests",
      "dependsOrder": "parallel",
      "dependsOn": [
        "run-tests",
        "run-frontend-tests",
        "run-ocr-tests"
      ],
      "problemMatcher": []
    },
    {
      "label": "start-full-stack",
      "dependsOrder": "parallel",
      "dependsOn": [
        "start-frontend"
      ],
      "problemMatcher": []
    }
  ]
}
