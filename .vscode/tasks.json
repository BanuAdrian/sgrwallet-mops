{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ensure-docker",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\ensure-docker.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-postgres",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-ocr",
      "type": "shell",
      "command": "docker compose up -d ocr-service",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-dev-services",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ensure-docker",
        "start-postgres",
        "start-ocr"
      ],
      "problemMatcher": []
    },
    {
      "label": "start-frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "frontend",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*http://localhost:5173"
        }
      },
      "dependsOn": "start-dev-services"
    },
    {
      "label": "run-tests",
      "type": "shell",
      "command": "mvn test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "start-full-stack",
      "dependsOrder": "parallel",
      "dependsOn": [
        "start-frontend"
      ],
      "problemMatcher": []
    }
  ]
}
